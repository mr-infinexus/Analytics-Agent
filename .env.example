# API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Primary Provider (Groq) & Default Models
PRIMARY_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Fallback Provider (Gemini) & Cascade Models
FALLBACK_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Evaluation Judge Configuration
EVAL_PROVIDER=groq
EVAL_MODEL=openai/gpt-oss-20b

# Vector DB & Embedding Configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
CHROMA_PERSIST_DIR=./chroma_store

# Data Files Directory
DATA_DIR=./data/Processed
RAW_DATA_DIR=./data/Data_files
